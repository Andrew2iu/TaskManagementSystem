   <string notr="true">/* 窗口背景 */
QMainWindow { background-color: #f5f6fa; }

/* 右侧 Frame 美化 */
QFrame#editPanel {
    background-color: white;
    border: 1px solid #dcdde1;
    border-radius: 10px;
    margin: 5px;
}

/* 搜索框圆角 */
QLineEdit#searchLineEdit {
    padding: 6px;
    border-radius: 15px;
    border: 1px solid #dcdde1;
}

/* 按钮样式 */
QPushButton {
    background-color: #4a90e2;
    color: white;
    border-radius: 4px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton#deleteTaskBtn {
    background-color: #e74c3c; /* 删除按钮红色 */
}
QPushButton:hover {
    background-color: #357abd;
}
QListWidget::item:selected {
    background-color: #ecf0f1; /* 浅灰色选中背景 */
    color: inherit;            /* 保持我们通过代码设置的字体颜色 */
    border-left: 5px solid #3498db; 
}</string>
